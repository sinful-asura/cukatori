# Copy to .env at the repo root (never commit .env).
#
# Local: npm run local -- db  (Docker Postgres on :5432)
#        npm run local -- api (Nest watch on the host)
#        npm run local -- fe  (ng serve on the host)
# Production: docker compose -f docker/docker-compose.prod.yaml up -d

# PostgreSQL
POSTGRES_USER=cukatori
POSTGRES_PASSWORD=cukatori
POSTGRES_DB=cukatori
# Local Nest (host → published Docker port):
DATABASE_URL=postgresql://cukatori:cukatori@localhost:5432/cukatori

# API
JWT_SECRET=change-me-in-production
# Access cookie lifetime. Kept short-ish because the refresh cookie renews it silently.
JWT_EXPIRES_IN=1d
# Refresh cookie lifetime; slides forward on every refresh, so active users stay signed in.
REFRESH_EXPIRES_IN=30d
# Must stay true in production. Local http turns this off so the browser keeps the cookies.
AUTH_COOKIE_SECURE=false
PORT=3000
CORS_ORIGINS=http://localhost:4200
NODE_ENV=development
RUN_MIGRATIONS=true
UPLOAD_DIR=uploads

# Docker Hub (npm run deploy)
DOCKER_REGISTRY=your-dockerhub-username
IMAGE_TAG=latest
